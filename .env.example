# 复制为 .env 后，shlink-go 启动时会自动加载；已存在的系统环境变量优先

# 必填：PostgreSQL 连接串
DATABASE_URL=postgres://shlink:shlink@localhost:5432/shlink?sslmode=disable

# 可选：原 Shlink 的 PostgreSQL 连接串。仅支持迁移到空的新库；
# 配置后 serve 启动时会自动执行一次迁移，原库和新库不能是同一个数据库。
SHLINK_SOURCE_DATABASE_URL=

# HTTP 监听地址与对外短链域名
LISTEN_ADDR=:8080
DEFAULT_DOMAIN=s.example.com
IS_HTTPS_ENABLED=false

# 空库时创建第一个管理员 API Key；已有任意 API Key 时不会再创建
INITIAL_API_KEY=

# 可选：GeoLite2 City 数据库；留空表示不解析地理位置
GEOLITE2_CITY_DB_PATH=

# 反向代理与 CORS
TRUSTED_PROXIES=127.0.0.1,::1
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=3600

# 短链行为
SHORT_URL_TRAILING_SLASH=false
EXTRA_PATH_MODE=default
DISABLE_TRACK_PARAM=
DEFAULT_SHORT_CODES_LENGTH=5
DEFAULT_SHORT_CODES_CHARS=0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ

# 访问记录
ANONYMIZE_REMOTE_IP=true
TRACK_ORPHAN_VISITS=true

# 日志
LOG_LEVEL=info
